# Copy to .env and fill in. Never commit .env.

# dev (OpenAI) | offline (no API key: hashing embedder + extractive fake LLM) | prod
# | local-ollama (local models through Ollama; `make up-ollama`)
CHATBOT_PROFILE=dev

# Needed for the dev/prod profiles.
OPENAI_API_KEY=

# SHA-256 hashes of allowed API keys, comma-separated. Create one with `make api-key`.
CHATBOT_API_KEYS=

# Only for auth.mode jwt with HS256 dev tokens (`chatbot dev-token`); 32+ random characters.
# DEV_JWT_SECRET=

# Used when running outside Docker (`uv run chatbot ...`). Compose sets its own.
DATABASE_URL=postgresql://chatbot:chatbot@localhost:5432/chatbot

# Ollama, when running it natively on this machine (Compose points the app at its own
# container otherwise). From Docker on macOS: http://host.docker.internal:11434
# OLLAMA_BASE_URL=http://localhost:11434

# Qdrant as the vector store (`make up-qdrant`): select it, and give its URL outside Docker.
# CHATBOT__VECTOR_STORE__BACKEND=qdrant
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Any setting can be overridden: CHATBOT__<SECTION>__<KEY>=value
# CHATBOT__RETRIEVAL__TOP_K=5
# CHATBOT__ANSWER__STREAM_MODE=buffered
