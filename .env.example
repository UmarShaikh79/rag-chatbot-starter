# Copy to .env and fill in. Never commit .env.

# dev (OpenAI) | offline (no API key: hashing embedder + extractive fake LLM) | prod
# | local-ollama (local models through Ollama; `make up-ollama`)
CHATBOT_PROFILE=dev

# Needed for the dev/prod profiles.
OPENAI_API_KEY=

# SHA-256 hashes of allowed API keys, comma-separated. Create one with `make api-key`.
CHATBOT_API_KEYS=

# Only for auth.mode jwt with HS256 dev tokens (`chatbot dev-token`); 32+ random characters.
# DEV_JWT_SECRET=

# Sign-in with your identity provider (JWT/OIDC; docs/configuration.md, `auth`). The issuer must
# equal the tokens' `iss`; signing keys are found through its OIDC discovery document.
# CHATBOT__AUTH__MODE=api_key_or_jwt                    # or jwt
# CHATBOT__AUTH__JWT__ISSUER=https://your-tenant.eu.auth0.com/
# CHATBOT__AUTH__JWT__AUDIENCE=https://chatbot.example.com

# Used when running outside Docker (`uv run chatbot ...`). Compose sets its own.
DATABASE_URL=postgresql://chatbot:chatbot@localhost:5432/chatbot

# Ollama, when running it natively on this machine (Compose points the app at its own
# container otherwise). From Docker on macOS: http://host.docker.internal:11434
# OLLAMA_BASE_URL=http://localhost:11434
# Models the `ollama-pull` service downloads (`make ollama-pull`), as one shell command.
# OLLAMA_MODELS_CMD=ollama pull nomic-embed-text && ollama pull gemma3:4b && ollama pull qwen3.5:9b

# Qdrant as the vector store (`make up-qdrant`): select it, and give its URL outside Docker.
# CHATBOT__VECTOR_STORE__BACKEND=qdrant
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Reranking with Cohere (retrieval.rerank; config/models.yaml `cohere:rerank`). After turning it
# on, run `chatbot calibrate --apply` (rerank scores are on a different scale).
# COHERE_API_KEY=
# CHATBOT__RETRIEVAL__RERANK__ENABLED=true

# A `sql` ingestion source reads its URL from the env var named in its `url_env`
# (config/app.yaml, `sources`); DATABASE_URL when unset.
# APP_DATABASE_URL=postgresql://reader:...@db.example.com:5432/app

# Optional packages baked into the Docker image (`make up` reads this file), e.g.
# "--extra otel --extra presidio". Presidio also needs SPACY_MODEL_URL; see docs/configuration.md.
# UV_EXTRAS=

# Any setting can be overridden: CHATBOT__<SECTION>__<KEY>=value
# CHATBOT__RETRIEVAL__TOP_K=5
# CHATBOT__ANSWER__STREAM_MODE=buffered

# Tracing and metrics (docs/observability.md). Build with the otel extra
# (UV_EXTRAS="--extra otel", or `make up-otel` for a local collector and Jaeger).
# CHATBOT__OBSERVABILITY__OTEL__ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318     # Compose sets its own collector
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20...
# OTEL_SERVICE_NAME=support-bot                          # default: app.name

# Langfuse (UV_EXTRAS="--extra langfuse"): keys from your Langfuse project settings.
# CHATBOT__OBSERVABILITY__LANGFUSE__ENABLED=true
# LANGFUSE_BASE_URL=https://cloud.langfuse.com          # https://us.cloud.langfuse.com, self-hosted URL
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...

# LangGraph as the orchestrator (UV_EXTRAS="--extra langgraph"):
# CHATBOT__ORCHESTRATOR=langgraph
