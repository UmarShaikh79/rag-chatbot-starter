# Copy to .env and fill in. Never commit .env.
#
# Every variable the template reads is listed here, without a value. The four at the top are
# used by the default setup; everything commented out is optional: uncomment it only when you
# use that feature. Leave a CHATBOT__... line commented unless you give it a value (an empty
# override is rejected at startup). Examples are in the comment above each line.


# ---------------------------------------------------------------- required for the default setup

# Which config/profiles/<name>.yaml to use. Empty means dev.
#   dev           OpenAI models (needs OPENAI_API_KEY)
#   offline       no API key: hashing embedder and an extractive fake LLM
#   local-ollama  local models through Ollama (`make up-ollama`)
#   prod          your production settings
CHATBOT_PROFILE=

# OpenAI key, for the dev and prod profiles. Not needed for offline or local-ollama.
OPENAI_API_KEY=

# SHA-256 hashes of the API keys clients may use, comma-separated (auth.mode api_key, the
# default). `make api-key` prints a new key and its hash.
CHATBOT_API_KEYS=

# Postgres, when running outside Docker (`uv run chatbot ...`); Compose sets its own.
# e.g. postgresql://chatbot:chatbot@localhost:5432/chatbot
DATABASE_URL=


# ---------------------------------------------------------------- sign-in (JWT / OIDC)

# Tokens from your identity provider (docs/configuration.md, `auth`). Mode: api_key (default),
# jwt, api_key_or_jwt or none. The issuer must equal the tokens' `iss`, e.g.
# https://your-tenant.eu.auth0.com/; the audience must appear in their `aud`.
# CHATBOT__AUTH__MODE=
# CHATBOT__AUTH__JWT__ISSUER=
# CHATBOT__AUTH__JWT__AUDIENCE=

# Local development without an identity provider: HS256 tokens from `chatbot dev-token`. Point
# hs256_secret_env at the variable below (DEV_JWT_SECRET) and give that 32+ random characters.
# CHATBOT__AUTH__JWT__HS256_SECRET_ENV=
# DEV_JWT_SECRET=


# ---------------------------------------------------------------- models and retrieval

# Ollama running natively instead of in Compose, e.g. http://localhost:11434, or from Docker on
# macOS http://host.docker.internal:11434. Empty: Compose uses its own Ollama container.
# OLLAMA_BASE_URL=

# The models `make ollama-pull` downloads, as one shell command, e.g.
# ollama pull nomic-embed-text && ollama pull gemma3:4b && ollama pull qwen3.5:9b
# OLLAMA_MODELS_CMD=

# Hosted Ollama or a proxy that wants a bearer token: set `api_key_env: OLLAMA_API_KEY` on the
# model in config/models.yaml, then the key here.
# OLLAMA_API_KEY=

# Reranking with Cohere (config/models.yaml `cohere:rerank`). Set ENABLED to true, then run
# `chatbot calibrate --apply` (rerank scores are on a different scale).
# COHERE_API_KEY=
# CHATBOT__RETRIEVAL__RERANK__ENABLED=

# Qdrant as the vector store (`make up-qdrant`): set BACKEND to qdrant. The URL is for running
# outside Docker, e.g. http://localhost:6333; the key is for Qdrant Cloud.
# CHATBOT__VECTOR_STORE__BACKEND=
# QDRANT_URL=
# QDRANT_API_KEY=

# A `sql` ingestion source reads its connection URL from the variable named in its `url_env`
# (config/app.yaml, `sources`; DATABASE_URL when unset), e.g.
# postgresql://reader:...@db.example.com:5432/app
# APP_DATABASE_URL=


# ---------------------------------------------------------------- behaviour

# Browser apps on another domain calling the API directly (CORS), e.g.
# [https://app.example.com]. Off until set; servers and mobile apps don't need it.
# CHATBOT__API__CORS__ALLOW_ORIGINS=

# LangGraph as the orchestrator: langgraph (needs the langgraph extra).
# CHATBOT__ORCHESTRATOR=

# PII detectors for user messages, e.g. [regex, presidio] (needs the presidio extra).
# CHATBOT__GUARDRAILS__PII__DETECTORS=

# Any setting in config/app.yaml can be overridden as CHATBOT__<SECTION>__<KEY>, e.g.
# CHATBOT__RETRIEVAL__TOP_K with 5, or CHATBOT__ANSWER__STREAM_MODE with buffered.
# CHATBOT__RETRIEVAL__TOP_K=
# CHATBOT__ANSWER__STREAM_MODE=


# ---------------------------------------------------------------- tracing and metrics

# OpenTelemetry (docs/observability.md; needs the otel extra, or `make up-otel` for a local
# collector and Jaeger): set ENABLED to true. The endpoint is for running outside Docker, e.g.
# http://localhost:4318 (Compose sets its own collector). Headers, e.g.
# authorization=Bearer%20<token>. Service name defaults to app.name. Resource attributes, e.g.
# deployment.environment.name=staging.
# CHATBOT__OBSERVABILITY__OTEL__ENABLED=
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_SERVICE_NAME=
# OTEL_RESOURCE_ATTRIBUTES=

# Langfuse (needs the langfuse extra): set ENABLED to true, and the keys from your Langfuse
# project settings (pk-lf-..., sk-lf-...). The base URL defaults to https://cloud.langfuse.com;
# set it for https://us.cloud.langfuse.com or a self-hosted Langfuse.
# CHATBOT__OBSERVABILITY__LANGFUSE__ENABLED=
# LANGFUSE_BASE_URL=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=


# ---------------------------------------------------------------- Docker and tooling

# Optional packages baked into the Docker image (`make up` reads this file), e.g.
# --extra otel --extra presidio. Presidio also needs the SPACY_MODEL_URL build argument; see
# docs/configuration.md.
# UV_EXTRAS=

# Where config/ lives, when the app runs from another directory. The Docker image sets /app.
# CHATBOT_ROOT=


# ---------------------------------------------------------------- tests (make test-db, opt-in suites)

# Postgres for integration tests, e.g. postgresql://chatbot:chatbot@localhost:5432/chatbot_test
# (`make test-db` uses that one by default).
# TEST_DATABASE_URL=

# A real Qdrant server for its integration tests, e.g. http://localhost:6333 (default:
# Qdrant's in-process mode).
# QDRANT_TEST_URL=

# Live suites: OLLAMA_TEST_URL, e.g. http://localhost:11434, runs tests/e2e/test_live_ollama.py;
# RUN_LIVE_TESTS set to 1 (with OPENAI_API_KEY) runs tests/e2e/test_live_openai.py.
# OLLAMA_TEST_URL=
# RUN_LIVE_TESTS=
